{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "lib": [
      "es6",
      "dom"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "allowJs": true,
    "strictPropertyInitialization": true,
    "skipLibCheck": true,
    "outDir": "build",
  },
  "exclude": [
    "node_modules",
    "build"
  ]
}
